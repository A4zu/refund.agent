# Bu faylı .env adı ilə kopyalayın və öz məlumatlarınızı daxil edin:
#   cp .env.example .env

# OpenAI API açarınız (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# İstifadə olunacaq model (istəyə bağlı, default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Göndərən Gmail hesabı və App Password
# App Password yaratmaq üçün: https://myaccount.google.com/apppasswords
# (adi Gmail şifrənizi DEYİL, 16 hərflik App Password-u daxil edin, boşluqsuz)
GMAIL_ADDRESS=sizin-gonderen-hesabiniz@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# Refund sorğularının göndəriləcəyi email (insan nəzarətçi)
RECEIVER_EMAIL=nezaretci@example.com
